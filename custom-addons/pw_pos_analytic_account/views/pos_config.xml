<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_analytic" model="ir.ui.view">
        <field name="name">res.config.setting.form.inherit.analytic</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_accounting_section" position="inside">
                <setting groups="analytic.group_analytic_accounting">
                    <span class="o_form_label">Analytic Account</span>
                        <div class="text-muted">
                            Set analytic account for journal entries and pos orders
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label string="Analytic Account"
                                       for="account_analytic_id"
                                       class="col-md-3 o_light_label"
                                       widget="selection"/>
                                <field name="account_analytic_id"/>
                            </div>
                        </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
