<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Muestra debajo de la línea de pago los datos capturados en el popup de
        restricción (p. ej. "Habitación: 101").

        Se inyecta al final del t-foreach de las líneas, por lo que aparece
        tanto si la línea está seleccionada como si no (paridad con Odoo 17).
        Los datos los arma `restrictionDataDisplay` en
        payment_line_restriction_data.js.
    -->
    <t t-name="pos_payment_method_restrict.PaymentScreenPaymentLines"
       t-inherit="point_of_sale.PaymentScreenPaymentLines"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='props.paymentLines']" position="inside">
            <t t-set="restrictionItems" t-value="restrictionDataDisplay(line)"/>
            <div t-if="restrictionItems.length"
                 class="payment-restriction-data d-flex flex-column px-3 pb-2">
                <t t-foreach="restrictionItems" t-as="item" t-key="item.key">
                    <div class="d-flex justify-content-between align-items-baseline gap-3">
                        <span class="text-muted text-truncate">
                            <i class="fa fa-angle-right me-1" role="img"/>
                            <t t-esc="item.label"/>
                        </span>
                        <span class="fw-bolder text-end text-truncate">
                            <t t-esc="item.value"/>
                        </span>
                    </div>
                </t>
            </div>
        </xpath>
    </t>

</templates>
