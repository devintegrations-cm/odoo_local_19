<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_proceso_confirmacion_wizard" model="ir.ui.view">
        <field name="name">confirmation.variation.wizard.form</field>
        <field name="model">confirmation.variation.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar Acción">
                <group>
                    <field name="message" widget="html" readonly="1"/>
                    <field name="purchase_order_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cerrar" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
