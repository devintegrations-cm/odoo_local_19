<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_proceso_advertencia_wizard" model="ir.ui.view">
        <field name="name">warning.variation.wizard.form</field>
        <field name="model">warning.variation.wizard</field>
        <field name="arch" type="xml">
            <form string="Advertencia Acción">
                <group>
                    <field name="message" widget="html" readonly="1"/>
                </group>
                <footer>
                    <button name="action_close" string="Cerrar" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
