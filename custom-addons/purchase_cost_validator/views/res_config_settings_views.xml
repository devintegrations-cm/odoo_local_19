<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Only a shortcut: the general settings page cannot be saved while point of sale sessions are open, so the
         validator keeps its options in its own screen (Compras › Configuración › Validador de costos). -->
    <record id="res_config_settings_view_form_cost_validator" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.purchase.cost.validator</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="after">
                <block title="Validador de costos" name="purchase_cost_validator_container" groups="base.group_system">
                    <setting id="purchase_cost_validator" string="Revisión de costos en compras" help="Compara cada precio con el costo del producto, en la misma unidad de medida, con la Variación de Costo de cada producto como margen. Rojo: precio en cero o desfase incoherente. Amarillo: fuera de la tolerancia del producto. Nunca bloquea la orden.">
                        <button name="%(purchase_cost_validator.action_purchase_cost_validator_config)d" type="action" string="Configurar revisor, fecha de arranque y retención" class="btn-link" icon="oi-arrow-right"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
