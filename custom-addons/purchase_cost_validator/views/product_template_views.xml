<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- A red banner while the cost is being edited; it never blocks the save. -->
    <record id="product_template_form_cost_edit" model="ir.ui.view">
        <field name="name">product.template.form.cost.validator</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="cost_edit_warning" invisible="1"/>
                <div class="alert alert-danger mb-0 py-2" role="alert" invisible="not cost_edit_warning">
                    <i class="fa fa-exclamation-triangle me-1" title="Cambio de costo"/>
                    Ey, revisa el costo: <field name="cost_edit_warning" class="d-inline fw-bold" readonly="1"/> Se puede guardar igual; si no era lo esperado, el inventario de este producto se revalora con ese costo.
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Validador de costos" name="cost_validator" groups="base.group_system">
                    <group>
                        <field name="porcent_variation" string="Variación de Costo (%)"/>
                        <div class="text-muted" colspan="2">Margen permitido entre el precio de compra y el costo de este producto: fuera de él, la línea de la orden sale en amarillo. Más del doble o menos de la mitad del costo sale en rojo.</div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
