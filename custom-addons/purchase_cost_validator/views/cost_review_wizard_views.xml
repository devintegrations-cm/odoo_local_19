<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_cost_review_wizard_form" model="ir.ui.view">
        <field name="name">purchase.cost.review.wizard.form</field>
        <field name="model">purchase.cost.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Recepción con desfase de costo">
                <field name="can_approve" invisible="1"/>
                <field name="message" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_approve" type="object" string="Recibir de todas formas" class="btn-danger" invisible="not can_approve"/>
                    <button name="action_open_orders" type="object" string="Revisar la orden de compra" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
