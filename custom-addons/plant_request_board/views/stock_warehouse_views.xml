<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Plant and store flags on the warehouse itself -->
    <record id="view_warehouse_inherit_plant" model="ir.ui.view">
        <field name="name">stock.warehouse.form.inherit.plant.request.board</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="plant_is_plant"/>
                <field name="plant_is_store"/>
            </xpath>
        </field>
    </record>
    <record id="view_warehouse_tree_inherit_plant" model="ir.ui.view">
        <field name="name">stock.warehouse.tree.inherit.plant.request.board</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="plant_is_plant" optional="show"/>
                <field name="plant_is_store" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
