<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maintenance_checklist_template_form" model="ir.ui.view">
        <field name="name">maintenance.checklist.template.form</field>
        <field name="model">maintenance.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de checklist">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="p. ej. Checklist Nevera"/>
                        </h1>
                    </div>
                    <group>
                        <field name="category_id"/>
                    </group>
                    <notebook>
                        <page string="Ítems" name="items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_maintenance_checklist_template_list" model="ir.ui.view">
        <field name="name">maintenance.checklist.template.list</field>
        <field name="model">maintenance.checklist.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas de checklist">
                <field name="name"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>

    <record id="action_maintenance_checklist_template" model="ir.actions.act_window">
        <field name="name">Plantillas de Checklist</field>
        <field name="res_model">maintenance.checklist.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una plantilla de checklist para una categoría de equipo
            </p>
            <p>
                Los ítems de la plantilla se copiarán automáticamente al
                checklist de cada solicitud de mantenimiento cuyo equipo
                pertenezca a la categoría seleccionada.
            </p>
        </field>
    </record>

</odoo>
