<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_payment_dispersion_inherit_view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.dispersion.inherit.view.account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_method_code']" position="after">
                <field name="is_colombian_dispersion" invisible="1"/>
            </xpath>

            <xpath expr="//group[@name='group2']" position="inside">
                <field name="type_of_account"
                    readonly="1"
                    invisible="not is_colombian_dispersion"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <notebook invisible="payment_type != 'outbound'" name="dispersion_banks">
                </notebook>
            </xpath>

        </field>
    </record>
</odoo>
