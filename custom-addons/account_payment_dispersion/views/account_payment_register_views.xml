<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_dispersion" model="ir.ui.view">
        <field name="name">account.payment.register.form.dispersion</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='show_partner_bank_account']" position="after">
                <field name="payment_method_code" invisible="1"/>
                <field name="is_colombian_dispersion" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="type_of_account"
                       readonly="1"
                       invisible="not is_colombian_dispersion or not show_partner_bank_account"/>
            </xpath>
        </field>
    </record>
</odoo>
