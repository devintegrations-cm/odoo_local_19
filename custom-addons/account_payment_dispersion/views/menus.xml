<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú raíz en Configuración: es el parent de los menús de
         configuración de los módulos de banco (Bancolombia y Occidente
         cuelgan de él); eliminarlo rompe su instalación limpia (External
         ID not found) y su upgrade (menú huérfano con error por
         ondelete="restrict"). Grupo: solo gerentes de contabilidad. -->
    <menuitem parent="account.menu_finance_configuration"
              id="account_payment_dispersed_root_menu"
              name="Dispersed Payments"
              groups="account.group_account_manager"
              sequence="100"/>
    <!-- Acceso al historial desde Configuración (tercera entrada de la v17;
         sin ella el upgrade la borraría por quedar sin xmlid). -->
    <menuitem parent="account_payment_dispersion.account_payment_dispersed_root_menu"
              id="account_payment_dispersed_submenu"
              action="account_payment_dispersion.account_payment_dispersal_action"
              sequence="1"/>
    <!-- Entrada de consulta de dispersiones históricas en Contabilidad →
         Proveedores (solo lectura; la acción y las vistas no permiten
         crear, editar ni borrar). -->
    <menuitem id="account_payment_dispersed_submenu_finance_payables"
              parent="account.menu_finance_payables"
              action="account_payment_dispersion.account_payment_dispersal_action"
              sequence="500"/>
</odoo>
