<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

    <!--
        The whole design lives under .cash-move-confirm-popup and brings its own
        header/body/footer rules, so the standard Dialog header is turned off and
        its padding is neutralized to let those styles breathe.
    -->
    <t t-name="pos_cash_in_out_message.CashMoveConfirmPopup">
        <Dialog header="false" bodyClass="'p-0'">
            <div class="cash-move-confirm-popup">

                <div class="popup-header">
                    <div t-attf-class="confirm-icon {{movementTypeClass}}">
                        <i t-attf-class="{{iconClass}}"/>
                    </div>
                    <div class="popup-title">
                        <t t-esc="props.title"/>
                    </div>
                </div>

                <div class="popup-body">
                    <p class="movement-description">
                        Está a punto de registrar un
                        <span t-attf-class="movement-type {{movementTypeClass}}"
                              t-esc="movementTypeLabel"/>.
                    </p>

                    <div t-attf-class="movement-amount {{movementTypeClass}}">
                        <t t-esc="props.formattedAmount"/>
                    </div>

                    <div class="confirm-question">¿Desea continuar?</div>

                    <div t-if="props.isLastMovement" class="last-movement-warning">
                        <i class="fa fa-exclamation-triangle warning-icon"/>
                        <div class="warning-text">
                            <strong>Último movimiento permitido</strong>
                            Este será el último movimiento de efectivo que podrá
                            registrar en esta sesión. No podrá realizar más
                            movimientos Cash In/Out después de este.
                        </div>
                    </div>

                    <div t-if="props.configMessage" class="config-message">
                        <i class="fa fa-info-circle message-icon"/>
                        <div class="message-text" t-esc="props.configMessage"/>
                    </div>
                </div>

                <div class="footer">
                    <button type="button" class="button confirm-btn" t-on-click="confirm">
                        <t t-esc="props.confirmLabel"/>
                    </button>
                    <button type="button" class="button cancel-btn" t-on-click="cancel">
                        <t t-esc="props.cancelLabel"/>
                    </button>
                </div>

            </div>
        </Dialog>
    </t>

</templates>
