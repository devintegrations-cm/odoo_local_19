<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_restrict_del_ordered_order_line.Orderline"
       t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension">

        <xpath expr="//li[hasclass('price-per-unit')]" position="after">
            <t t-if="props.mode != 'receipt' and props.line.shouldShowOrderedQty() and isProductScreenFun()">
                <div class="ordered-qty-container">
                    <div class="ordered-qty-actions">
                        <button class="ordered-qty-btn minus" t-on-click="subsQuantity" type="button">
                            <i class="fa fa-minus-square" aria-hidden="true"></i>
                        </button>
                        <span class="ordered-qty-value">
                            <t t-esc="props.line.ordered_quantities"/>
                        </span>
                        <button class="ordered-qty-btn plus" t-on-click="addQuantity" type="button">
                            <i class="fa fa-plus-square" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span class="ordered-qty-label">En preparación</span>
                </div>
            </t>
        </xpath>

    </t>
</templates>
