<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Escritorio: columna de control, junto al botón nativo "Cliente".
         Se oculta el botón "Guardar orden para más tarde" (fa-upload). -->
    <t t-name="pos_dian_client.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="pos.config.show_dian_client_button and !props.showRemainingButtons"
                    class="set-partner btn btn-secondary btn-lg lh-lg text-truncate w-auto"
                    title="Validar cliente contra la DIAN"
                    t-on-click="() => this.openDianClientPopup()">
                <i class="fa fa-file-text-o me-2"/>Factura electrónica
            </button>
        </xpath>
        <xpath expr="//button[.//i[hasclass('fa-upload')]]" position="replace"/>
    </t>

    <!-- Pantallas chicas: la fila de la ActionPad que ya trae el botón Cliente.
         También se oculta su botón "Guardar orden" (fa-upload). -->
    <t t-name="pos_dian_client.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="pos.config.show_dian_client_button"
                    class="set-partner btn btn-secondary btn-lg lh-lg text-truncate"
                    title="Validar cliente contra la DIAN"
                    t-on-click="() => this.openDianClientPopup()">
                <i class="fa fa-file-text-o me-1"/>FE
            </button>
        </xpath>
        <xpath expr="//button[.//i[hasclass('fa-upload')]]" position="replace"/>
    </t>

    <!-- Pantalla de pago: justo debajo de Cliente / Recibo-Factura. -->
    <t t-name="pos_dian_client.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[@class='d-flex flex-column flex-sm-row gap-1 w-100']" position="after">
            <button t-if="pos.config.show_dian_client_button"
                    class="button btn btn-secondary btn-lg w-100 lh-lg text-truncate mt-1"
                    title="Validar cliente contra la DIAN"
                    t-on-click="() => this.openDianClientPopup()">
                <i class="fa fa-file-text-o me-2"/>Factura electrónica
            </button>
        </xpath>
    </t>

</templates>
