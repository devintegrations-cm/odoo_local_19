<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Escritorio: columna de control, junto al botón nativo "Cliente".
         Se oculta el botón "Guardar orden para más tarde" (fa-upload) y,
         opcionalmente (dianHidesPartner), el botón nativo de Cliente. -->
    <t t-name="pos_dian_client.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="pos.config.show_dian_client_button and !props.showRemainingButtons"
                    class="set-partner btn btn-secondary btn-lg lh-lg text-truncate w-auto"
                    title="Validar cliente contra la DIAN"
                    t-on-click="() => this.openDianClientPopup()">
                <i class="fa fa-file-text-o me-2"/>Factura electrónica
                <div t-if="dianHidesPartner and partner"
                     class="text-truncate text-action small w-100"
                     t-out="partner.name"/>
            </button>
        </xpath>
        <xpath expr="//SelectPartnerButton" position="attributes">
            <attribute name="t-if">!props.showRemainingButtons and !dianHidesPartner</attribute>
        </xpath>
        <xpath expr="//button[.//i[hasclass('fa-upload')]]" position="replace"/>
    </t>

    <!-- Pantallas chicas: la fila de la ActionPad que ya trae el botón Cliente.
         También se oculta su botón "Guardar orden" (fa-upload). -->
    <t t-name="pos_dian_client.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="pos.config.show_dian_client_button"
                    class="set-partner btn btn-secondary btn-lg lh-lg text-truncate"
                    title="Validar cliente contra la DIAN"
                    t-on-click="() => this.openDianClientPopup()">
                <i class="fa fa-file-text-o me-1"/>FE
                <span t-if="dianHidesPartner and props.partner"
                      class="text-truncate text-action ms-1" t-out="props.partner.name"/>
            </button>
        </xpath>
        <xpath expr="//SelectPartnerButton" position="attributes">
            <attribute name="t-if">!dianHidesPartner</attribute>
        </xpath>
        <xpath expr="//button[.//i[hasclass('fa-upload')]]" position="replace"/>
    </t>

    <!-- Botón "Factura electrónica" de la pantalla de pago (se llama con t-call
         desde PaymentScreenButtons, así que el contexto es PaymentScreen). -->
    <t t-name="pos_dian_client.PaymentDianButton">
        <button class="button btn btn-lg w-100 text-truncate"
                t-attf-class="{{ dianHidesPartner and currentOrder.isCustomerRequired and !currentOrder.getPartner() ? 'btn-primary' : 'btn-secondary' }} {{ dianHidesPartner ? 'flex-sm-grow-1 lh-base' : 'mt-1 lh-lg' }}"
                title="Validar cliente contra la DIAN"
                t-on-click="() => this.openDianClientPopup()">
            <i class="fa fa-file-text-o me-2"/>Factura electrónica
            <div t-if="dianHidesPartner and currentOrder.getPartner()"
                 class="text-truncate text-action small w-100"
                 t-out="currentOrder.getPartner().name"/>
        </button>
    </t>

    <!-- Pantalla de pago (desktop y pequeña: el mismo t-call).
         Normal: "Factura electrónica" va en su propia fila, debajo de
         Cliente / Recibo-Factura.
         Con dianHidesPartner: ocupa el lugar de Cliente en esa fila, toma el
         espacio sobrante y Recibo/Factura queda al ancho de su contenido
         (en pantallas chicas la fila se apila, como en el core). -->
    <t t-name="pos_dian_client.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[@class='d-flex flex-column flex-sm-row gap-1 w-100']" position="after">
            <t t-if="pos.config.show_dian_client_button and !dianHidesPartner"
               t-call="pos_dian_client.PaymentDianButton"/>
        </xpath>
        <xpath expr="//button[hasclass('partner-button')]" position="before">
            <t t-if="dianHidesPartner" t-call="pos_dian_client.PaymentDianButton"/>
        </xpath>
        <xpath expr="//button[hasclass('partner-button')]" position="attributes">
            <attribute name="t-if">!dianHidesPartner</attribute>
        </xpath>
        <xpath expr="//button[hasclass('js_invoice')]" position="attributes">
            <attribute name="class" remove="w-md-50 lh-lg" separator=" "/>
            <attribute name="t-attf-class">{{ dianHidesPartner ? 'w-sm-auto flex-shrink-0 gap-2 lh-base' : 'w-md-50 lh-lg' }}</attribute>
        </xpath>
    </t>

</templates>
