<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Escritorio: columna de control, junto al botón nativo "Cliente".
         Se oculta el botón "Guardar orden para más tarde" (fa-upload) y,
         opcionalmente (hide_partner_button), el botón nativo de Cliente. -->
    <t t-name="pos_dian_client.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="pos.config.show_dian_client_button and !props.showRemainingButtons"
                    class="set-partner btn btn-secondary btn-lg lh-lg text-truncate w-auto"
                    title="Validar cliente contra la DIAN"
                    t-on-click="() => this.openDianClientPopup()">
                <i class="fa fa-file-invoice me-2"/>Factura electrónica
                <div t-if="pos.config.hide_partner_button and this.partner"
                     class="text-truncate text-action small w-100"
                     t-out="this.partner.name"/>
            </button>
        </xpath>
        <xpath expr="//SelectPartnerButton" position="replace">
            <SelectPartnerButton partner="partner"
                                 t-if="!props.showRemainingButtons and !pos.config.hide_partner_button"/>
        </xpath>
        <xpath expr="//button[.//i[contains(@class,'fa-upload')]]" position="replace"/>
    </t>

    <!-- Pantallas chicas: la fila de la ActionPad que ya trae el botón Cliente.
         También se oculta su botón "Guardar orden" (fa-upload). -->
    <t t-name="pos_dian_client.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="pos.config.show_dian_client_button"
                    class="set-partner btn btn-secondary btn-lg lh-lg text-truncate"
                    title="Validar cliente contra la DIAN"
                    t-on-click="() => this.openDianClientPopup()">
                <i class="fa fa-file-invoice me-1"/>FE
                <span t-if="pos.config.hide_partner_button and props.partner"
                      class="text-truncate text-action ms-1" t-out="props.partner.name"/>
            </button>
        </xpath>
        <xpath expr="//SelectPartnerButton" position="replace">
            <SelectPartnerButton partner="props.partner" t-if="!pos.config.hide_partner_button"/>
        </xpath>
        <xpath expr="//button[.//i[contains(@class,'fa-upload')]]" position="replace"/>
    </t>

    <!-- Pantalla de pago (desktop y pequeña: el mismo t-call): el botón
         "Factura electrónica" queda justo debajo de Cliente / Recibo-Factura.
         Con hide_partner_button, Cliente se oculta y Factura/Recibo pasa a
         ancho completo. -->
    <t t-name="pos_dian_client.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[@class='d-flex flex-column flex-sm-row gap-1 w-100']" position="after">
            <button t-if="pos.config.show_dian_client_button"
                    class="button btn btn-secondary btn-lg w-100 lh-lg text-truncate mt-1"
                    title="Validar cliente contra la DIAN"
                    t-on-click="() => this.openDianClientPopup()">
                <i class="fa fa-file-invoice me-2"/>Factura electrónica
                <div t-if="pos.config.hide_partner_button and currentOrder.getPartner()"
                     class="text-truncate text-action small w-100"
                     t-out="currentOrder.getPartner().name"/>
            </button>
        </xpath>
        <xpath expr="//button[hasclass('partner-button')]" position="replace">
            <button class="button partner-button btn btn-lg w-100 w-md-50 lh-lg text-truncate"
                    t-if="!pos.config.hide_partner_button"
                    t-att-class="{ 'highlight text-action': currentOrder.getPartner() }"
                    t-attf-class="{{ currentOrder.isCustomerRequired ? 'btn-primary' : 'btn-secondary' }}"
                    t-on-click="() => this.pos.selectPartner()">
                <i class="fa fa-user me-2" role="img" title="Customer"/>
                <span class="partner-name">
                    <t t-if="currentOrder.getPartner()" t-out="currentOrder.getPartner().name"/>
                    <t t-else="">Customer</t>
                </span>
            </button>
        </xpath>
        <xpath expr="//button[hasclass('js_invoice')]" position="replace">
            <button class="button js_invoice btn btn-secondary btn-lg d-flex justify-content-between align-items-baseline lh-lg"
                    t-att-class="{
                        'w-100': true,
                        'w-md-50': !pos.config.hide_partner_button,
                        'highlight': currentOrder.isToInvoice(),
                        'active': currentOrder.isToInvoice(),
                        'opacity-50': !pos.config.canInvoice,
                    }"
                    t-on-click="toggleIsToInvoice"
                    t-att-disabled="currentOrder.lines[0]?.refunded_orderline_id?.order_id?.isToInvoice()">
                <span>
                    <i class="fa fa-file-text-o me-2"/>
                    <t t-if="pos.config.canInvoice">Invoice</t>
                    <t t-else="">Not available</t>
                </span>
                <i class="fa me-2" t-attf-class="{{ currentOrder.isToInvoice() ? 'fa-check-square text-action' : 'fa-square-o' }}"/>
            </button>
        </xpath>
    </t>

</templates>
