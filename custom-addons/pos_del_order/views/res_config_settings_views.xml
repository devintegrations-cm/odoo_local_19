<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Same row/label/field shape that pos_hr uses in this part of the settings
        form: the anchor field lives inside a div, not inside its own <setting>.
    -->
    <record id="res_config_settings_view_form_inherit_pos_del_order" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_del_order</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_advanced_employee_ids'][@widget='many2many_tags']" position="after">
                <div class="row">
                    <label for="pos_del_able_employee_ids"
                           string="Borrar pedidos POS "
                           class="col-lg-4 o_light_label"/>
                    <field name="pos_del_able_employee_ids"
                           widget="many2many_tags"
                           placeholder="Todos los empleados "
                           domain="[('company_id', '=', company_id)]"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
