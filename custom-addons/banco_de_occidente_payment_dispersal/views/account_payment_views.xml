<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bancodeoccidente_payment_dispersal_inherit_view_account_payment_form" model="ir.ui.view">
        <field name="name">bancodeoccidente.payment.dispersal.inherit.view.account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="bancodeoccidente_form_of_payment"
                       invisible="payment_method_code != 'banco_occidente_dispersion'"/>
                <field name="bancodeoccidente_type_of_service"
                       invisible="payment_method_code != 'banco_occidente_dispersion'"/>
            </xpath>
        </field>
    </record>
</odoo>
