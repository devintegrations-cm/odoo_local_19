<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View res.partner.bank form -->
    <record id="banco_de_occidente_payment_dispersal_inherit_view_partner_bank_form" model="ir.ui.view">
        <field name="name">banco.de.occidente.payment.dispersal.inherit.view.partner.bank.form</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="account_payment_dispersion.account_payment_dispersion_inherit_view_partner_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook[@name='dispersion_banks']" position="inside">
                <page name="page_dispersion_bank_banco_de_occidente" string="Banco de Occidente">
                    <group>
                        <group>
                            <field name="bancodeoccidente_form_of_payment"/>
                        </group>
                        <group>
                            <field name="bancodeoccidente_type_of_service"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>