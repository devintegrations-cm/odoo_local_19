<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        En 19 el boton de propina del core vive en point_of_sale.PaymentScreenButtons
        (point_of_sale/static/src/app/screens/payment_screen/payment_screen.xml:133) y ya no
        tiene la clase 'js_tip' con la que lo ubicaba la version 17: se lo identifica por
        t-on-click="addTip".

        En vez de duplicar el markup del core, se lo oculta cuando hay porcentajes
        configurados y se agregan los botones de porcentaje a continuacion.
    -->
    <t t-name="pos_tip_percent.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">

        <xpath expr="//button[@t-on-click='addTip']" position="attributes">
            <attribute name="t-if">pos.config.iface_tipproduct and pos.config.tip_product_id and !(pos.config.iface_tippercent and (pos.config.tip_percent1 or pos.config.tip_percent2 or pos.config.tip_percent3))</attribute>
        </xpath>

        <xpath expr="//button[@t-on-click='addTip']" position="after">
            <t t-if="pos.config.iface_tippercent and pos.config.tip_product_id">
                <button t-if="pos.config.tip_percent1"
                        class="button js_tip_percent btn btn-secondary btn-lg d-flex justify-content-between align-items-baseline w-100 lh-lg"
                        t-att-class="{ 'highlight active text-action': shouldHighlight(pos.config.tip_percent1) }"
                        t-on-click="addTip1">
                    <span><i class="fa fa-percent me-2"/>Tip <t t-out="pos.config.tip_percent1"/> %</span>
                    <t t-out="env.utils.formatCurrency(getTipX(pos.config.tip_percent1))"/>
                </button>
                <button t-if="pos.config.tip_percent2"
                        class="button js_tip_percent btn btn-secondary btn-lg d-flex justify-content-between align-items-baseline w-100 lh-lg"
                        t-att-class="{ 'highlight active text-action': shouldHighlight(pos.config.tip_percent2) }"
                        t-on-click="addTip2">
                    <span><i class="fa fa-percent me-2"/>Tip <t t-out="pos.config.tip_percent2"/> %</span>
                    <t t-out="env.utils.formatCurrency(getTipX(pos.config.tip_percent2))"/>
                </button>
                <button t-if="pos.config.tip_percent3"
                        class="button js_tip_percent btn btn-secondary btn-lg d-flex justify-content-between align-items-baseline w-100 lh-lg"
                        t-att-class="{ 'highlight active text-action': shouldHighlight(pos.config.tip_percent3) }"
                        t-on-click="addTip3">
                    <span><i class="fa fa-percent me-2"/>Tip <t t-out="pos.config.tip_percent3"/> %</span>
                    <t t-out="env.utils.formatCurrency(getTipX(pos.config.tip_percent3))"/>
                </button>
            </t>
        </xpath>

    </t>

</templates>
