<odoo>

  <!-- ───────────────────────────── List ───────────────────────────── -->
  <record id="shopify_product_mapping_view_tree" model="ir.ui.view">
    <field name="name">shopify.product.mapping.tree</field>
    <field name="model">shopify.product.mapping</field>
    <field name="arch" type="xml">
      <list create="0" delete="0" editable="bottom" multi_edit="1"
            decoration-warning="state == 'unmapped'">
        <header>
          <button name="action_sync_from_shopify" type="object"
                  string="Sincronizar desde Shopify"
                  class="btn-primary" icon="fa-refresh"
                  display="always"/>
          <button name="action_clear_mapping" type="object"
                  string="Quitar mapeo" class="btn-secondary"/>
        </header>
        <field name="company_id" column_invisible="1"/>
        <field name="shopify_title" readonly="1"/>
        <field name="shopify_variant_title" readonly="1"/>
        <field name="shopify_sku" readonly="1"/>
        <field name="shopify_price" readonly="1" optional="show"/>
        <field name="shopify_status" string="Estado Shopify" readonly="1"
               widget="badge"
               decoration-success="shopify_status == 'ACTIVE'"
               decoration-info="shopify_status == 'DRAFT'"
               decoration-muted="shopify_status == 'ARCHIVED'"/>
        <field name="product_id"/>
        <field name="state" widget="badge"
               decoration-success="state == 'mapped'"
               decoration-warning="state == 'unmapped'"
               readonly="1"/>
      </list>
    </field>
  </record>

  <!-- ──────────────────────────── Search ──────────────────────────── -->
  <record id="shopify_product_mapping_view_search" model="ir.ui.view">
    <field name="name">shopify.product.mapping.search</field>
    <field name="model">shopify.product.mapping</field>
    <field name="arch" type="xml">
      <search>
        <field name="shopify_title" string="Producto/SKU"
               filter_domain="['|', ('shopify_title', 'ilike', self), ('shopify_sku', 'ilike', self)]"/>
        <field name="product_id"/>
        <!-- Estado Odoo -->
        <filter name="unmapped" string="Sin mapear"
                domain="[('state', '=', 'unmapped')]"/>
        <filter name="mapped" string="Mapeados"
                domain="[('state', '=', 'mapped')]"/>
        <separator/>
        <!-- Estado Shopify -->
        <filter name="shopify_active" string="Activo (Shopify)"
                domain="[('shopify_status', '=', 'ACTIVE')]"/>
        <filter name="shopify_draft" string="Borrador (Shopify)"
                domain="[('shopify_status', '=', 'DRAFT')]"/>
        <filter name="shopify_archived" string="Archivado (Shopify)"
                domain="[('shopify_status', '=', 'ARCHIVED')]"/>
        <group>
          <filter name="group_state" string="Estado Odoo"
                  context="{'group_by': 'state'}"/>
          <filter name="group_shopify_status" string="Estado Shopify"
                  context="{'group_by': 'shopify_status'}"/>
          <filter name="group_product" string="Producto Odoo"
                  context="{'group_by': 'product_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ──────────────────────────── Action ──────────────────────────── -->
  <record id="shopify_product_mapping_action" model="ir.actions.act_window">
    <field name="name">Mapeo de productos Shopify</field>
    <field name="res_model">shopify.product.mapping</field>
    <field name="view_mode">list</field>
    <field name="search_view_id" ref="shopify_product_mapping_view_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Aún no has traído productos de Shopify
      </p>
      <p>
        Pulsa <b>«Sincronizar desde Shopify»</b> para traer el catálogo de
        la tienda y asignar a cada variante su producto de Odoo.
      </p>
    </field>
  </record>

  <!-- ───────────────────────────── Menu ───────────────────────────── -->
  <menuitem id="menu_shopify_product_mapping"
            name="Mapeo de productos Shopify"
            parent="sale.product_menu_catalog"
            action="shopify_product_mapping_action"
            sequence="30"/>

</odoo>
