<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_config_view_form_custom_receipt_blocks" model="ir.ui.view">
        <field name="name">pos.config.form.custom.receipt.blocks</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">

                <div class="row mt16 o_settings_container"
                     id="custom_receipt_blocks_section"
                     groups="point_of_sale.group_pos_manager"
                     invisible="context.get('pos_config_create_mode', False)">

                    <h2>Ticket – Información adicional</h2>

                    <div class="text-muted mb-2">
                        Bloques que se imprimen en el ticket de este punto de venta.
                        Arrastra para reordenar; desactiva un bloque para dejar de
                        imprimirlo sin borrarlo.
                    </div>

                    <field name="custom_receipt_block_ids"
                           nolabel="1"
                           context="{'active_test': False}"/>

                </div>

            </xpath>

        </field>
    </record>

</odoo>