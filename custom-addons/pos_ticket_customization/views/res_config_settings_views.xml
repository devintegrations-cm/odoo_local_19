<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_custom_receipt_blocks"
            model="ir.ui.view">

        <field name="name">
            res.config.settings.form.custom.receipt.blocks
        </field>

        <field name="model">res.config.settings</field>

        <field name="inherit_id"
               ref="point_of_sale.res_config_settings_view_form"/>

        <field name="arch" type="xml">

            <xpath expr="//block[@id='pos_bills_and_receipts_section']"
                   position="inside">

                <setting id="pos_custom_receipt_blocks"
                         string="Información adicional en el ticket"
                         help="Bloques de texto, QR y códigos de barras propios de este punto de venta"
                         groups="point_of_sale.group_pos_manager">

                    <div class="content-group mt16">

                        <span class="text-muted">
                            Bloques configurados:
                            <field name="pos_custom_receipt_block_count"
                                   class="oe_inline"
                                   readonly="1"/>
                        </span>

                        <div class="mt8">

                            <button type="object"
                                    name="action_open_pos_custom_receipt_blocks"
                                    string="Configurar bloques"
                                    class="btn-link"
                                    icon="fa-arrow-right"
                                    invisible="not pos_config_id"/>

                        </div>

                    </div>

                </setting>

            </xpath>

        </field>
    </record>

</odoo>
