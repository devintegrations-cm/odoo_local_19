<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        En Odoo 17 el campo available_in_pos vivia dentro de un <group name="pos">, asi que
        insertar el many2many justo despues quedaba prolijo. En Odoo 19 available_in_pos se
        mudo a un <span class="d-inline-block"> al lado de su etiqueta, en la pestana Sales
        (point_of_sale/views/product_view.xml:95-100), y un widget many2many_tags ahi se
        renderiza apretado y sin etiqueta.

        El campo pasa a la pagina "Point of Sale", junto a las categorias del POS. Esa pagina
        ya es invisible cuando el producto no esta disponible en el punto de venta, que es
        exactamente cuando este campo no tiene sentido.
    -->
    <record id="ro_product_template_form_view_pos" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']//group[@name='pos']/field[@name='pos_categ_ids']"
                   position="after">
                <field name="ro_pos_config_ids"
                       widget="many2many_tags"
                       string="Puntos de venta"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
