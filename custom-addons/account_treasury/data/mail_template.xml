<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Editing form view-->
    <data noupdate="0">
        <record id="account_treasury.email_template_pay_not" model="mail.template">
        	<field name="name">AP: Payment Notification</field>
        	<field name="model_id" ref="account.model_account_payment"/>
        	<field name="subject">Notificación de Pago: {{ (object.name) }}</field>
        	<!--	Sender email    	-->
        	<field name="email_from">{{ (object.company_id.email) }}</field>
        	<!--   Recipient email     	-->
        	<field name="email_to">{{ (object.partner_id.email) }}</field>
        	<field name="auto_delete" eval="False"/>
        	<field name="body_html" type="html">
            	<div>
                    Cordial saludo, <t t-out="object.partner_id.name"/>,<br/><br/>
                    Se ha programado parcial/total de
                    <strong t-out="format_amount(object.amount, object.currency_id) or ''">$ 143,750.00</strong><t t-if="not object.reconciled_bill_ids">.</t><t t-else="">
                    correspondiente a las siguientes facturas:</t>
                    <ol t-if="object.reconciled_bill_ids">
                        <t t-foreach="object.reconciled_bill_ids" t-as="invoice_info">
                            <li>Factura: <t t-out="invoice_info.name"/>, 
                                <ul>
                                    <li>Referencia: <t t-out="invoice_info.ref"/></li>
                                    <li t-if="invoice_info.amount_paid!=0.0">Valor Pagado: <strong t-out="format_amount(invoice_info.amount_paid, object.currency_id) or ''">$ 10,500.00</strong>
                                    </li>
                                    <li t-if="invoice_info.amount_residual!=0.0">Valor Restante: <strong t-out="format_amount(invoice_info.amount_residual, object.currency_id) or ''">$ 10,500.00</strong>                                        
                                    </li>
                                    <li>Valor Total: <strong t-out="format_amount(invoice_info.amount_total, object.currency_id) or ''">$ 10,500.00</strong>
                                    </li>
                                </ul>
                            </li>
                        </t>
                    </ol> <br/>
                    Saludos,
                    <br/><br/>
                    <t t-out="object.company_id.name"/>
            	</div>
        	</field>
    	</record>
    </data>
</odoo>