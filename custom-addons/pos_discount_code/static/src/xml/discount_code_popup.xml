<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_discount_code.DiscountCodePopup">
        <Dialog title="title" size="'md'">
            <t t-if="state.phase === 'form'">
                <div class="mb-3">
                    <label class="form-label">Tipo de documento</label>
                    <select class="form-select" t-model="state.docType">
                        <t t-foreach="docTypes" t-as="dt" t-key="dt.value">
                            <option t-att-value="dt.value" t-out="dt.label"/>
                        </t>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Número de documento</label>
                    <input class="form-control" type="text" t-model="state.docNumber"
                           t-att-inputmode="docTypeIsNumeric ? 'numeric' : 'text'"
                           placeholder="Ej: 1032456789"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Código de descuento</label>
                    <input class="form-control" type="text" t-model="state.code"
                           placeholder="Ej: TEST"/>
                </div>
            </t>
            <t t-else="">
                <div class="alert alert-warning mb-2" t-if="state.replacing">
                    Se reemplazará el código actual: <b t-out="state.replacing"/>
                </div>
                <div class="mb-2">
                    <strong t-out="state.preview.name"/>
                </div>
                <table class="table table-sm">
                    <tr>
                        <td>Valor configurado</td>
                        <td t-out="state.preview.valorLabel"/>
                    </tr>
                    <tr>
                        <td>Vigencia</td>
                        <td t-out="state.preview.vigenciaLabel"/>
                    </tr>
                    <tr>
                        <td>Estado</td>
                        <td t-out="state.preview.estadoLabel"/>
                    </tr>
                    <tr>
                        <td>Tipo de documento</td>
                        <td t-out="docTypeLabel"/>
                    </tr>
                    <tr>
                        <td>Número de documento</td>
                        <td t-out="state.docNumber"/>
                    </tr>
                    <tr>
                        <td>Código</td>
                        <td t-out="state.code"/>
                    </tr>
                </table>
            </t>
            <div class="text-danger mt-2" t-if="state.error" t-out="state.error"/>
            <t t-set-slot="footer">
                <t t-if="state.phase === 'form'">
                    <button class="btn btn-primary btn-lg lh-lg" t-on-click="confirm">Validar</button>
                    <button class="btn btn-secondary btn-lg lh-lg" t-on-click="cancel">Cancelar</button>
                </t>
                <t t-else="">
                    <button class="btn btn-primary btn-lg lh-lg" t-on-click="confirm">Aplicar</button>
                    <button class="btn btn-secondary btn-lg lh-lg" t-on-click="backToForm">Modificar</button>
                    <button class="btn btn-secondary btn-lg lh-lg" t-on-click="cancel">Cancelar</button>
                </t>
            </t>
        </Dialog>
    </t>

</templates>
