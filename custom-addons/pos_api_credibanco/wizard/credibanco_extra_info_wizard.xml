<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_credibanco_extra_info_wizard" model="ir.ui.view">
        <field name="name">credibanco.extra.info.wizard.form</field>
        <field name="model">credibanco.extra.info.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar Información Manual">
                <group>
                    <field name="payment_order_id" invisible="1"/>
                    <field name="credibancoExtraField"/>
                    <field name="credibancoExtraValue"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Guardar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
