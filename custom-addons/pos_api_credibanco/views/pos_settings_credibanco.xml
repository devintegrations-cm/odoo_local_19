<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!--
        Odoo 19 renamed the list view type: <tree> is gone and view_mode no
        longer accepts "tree".
    -->
    <record id="pos_credibanco_settings_view_list" model="ir.ui.view">
        <field name="name">pos.settings.credibanco.list</field>
        <field name="model">pos.payment.method</field>
        <field name="arch" type="xml">
            <list string="Credibanco Settings" create="0" delete="0">
                <field name="name"/>
                <field name="use_payment_terminal"/>
                <field name="pos_payment_terminal_name"/>
                <field name="pos_ip_host"/>
                <field name="pos_websocket_port"/>
            </list>
        </field>
    </record>

    <record id="action_credibanco_settings_list" model="ir.actions.act_window">
        <field name="name">Credibanco Terminals</field>
        <field name="res_model">pos.payment.method</field>
        <field name="view_id" ref="pos_credibanco_settings_view_list"/>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pos_credibanco_config"
              name="Credibanco Settings"
              parent="point_of_sale.menu_point_config_product"
              action="action_credibanco_settings_list"
              sequence="6"
              groups="point_of_sale.group_pos_manager"/>

</odoo>
