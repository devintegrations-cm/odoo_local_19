<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!--
        The inherited pos.payment form has no <footer> (and no <header>) in Odoo
        19, so the manual-completion button belongs inside the sheet.
    -->
    <record id="view_pos_payment_form_credibanco_inherit" model="ir.ui.view">
        <field name="name">pos.payment.form.credibanco.inherit</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <group string="Información del datáfono">
                    <field name="credibanco_approval_number"/>
                    <field name="credibanco_extra_info" readonly="1" nolabel="1" colspan="2">
                        <list>
                            <field name="credibancoField"/>
                            <field name="credibancoValue"/>
                        </list>
                    </field>
                </group>
                <div class="d-flex justify-content-end">
                    <button name="open_credibanco_extra_info_wizard"
                            type="object"
                            string="Agregar información"
                            class="btn btn-primary"
                            groups="point_of_sale.group_pos_manager"/>
                </div>
            </sheet>
        </field>
    </record>
</odoo>
