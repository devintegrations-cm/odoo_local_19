<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- The only scheduled action of the module: one run a week, Sunday 22:00 America/Bogota (UTC-5, no DST:
             Monday 03:00 UTC), after the legalization bot's Sunday pass in Clara. It reads the transactions Clara
             created or updated since the last sync and the cards, nothing else. nextcall: the next Monday 03:00 UTC
             strictly after now (the 3-hour shift makes "today" end at 03:00 UTC, so a run still ahead tonight is not
             skipped). Day and hour are edited on this record. -->
        <record id="ir_cron_clara_weekly_sync" model="ir.cron">
            <field name="name">Clara: sincronización semanal (transacciones y tarjetas)</field>
            <field name="model_id" ref="model_clara_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_weekly_sync()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now(pytz.utc).replace(tzinfo=None) + relativedelta(hours=-3) + relativedelta(days=1, weekday=0, hour=3, minute=0, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
