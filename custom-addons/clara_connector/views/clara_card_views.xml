<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cards are a mirror of Clara: nobody creates, edits or deletes them by hand -->
    <record id="view_clara_card_tree" model="ir.ui.view">
        <field name="name">clara.card.tree</field>
        <field name="model">clara.card</field>
        <field name="arch" type="xml">
            <list string="Tarjetas" create="false" edit="false" delete="false" default_group_by="area"
                  decoration-danger="status == 'blocked'" decoration-muted="status in ('inactive', 'cancelled')">
                <header>
                    <button name="action_sync_now" type="object" string="Sincronizar ahora" display="always" class="btn-primary" icon="fa-refresh"
                            groups="clara_purchase_bridge.group_clara_admin"/>
                </header>
                <field name="cardholder_name"/>
                <field name="last_four"/>
                <field name="card_type"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-danger="status == 'blocked'" decoration-muted="status in ('inactive', 'cancelled')"/>
                <field name="monthly_limit" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="area"/>
                <field name="analytic_account_id"/>
                <field name="alias" optional="hide"/>
                <field name="cardholder_email" optional="hide"/>
                <field name="status_raw" optional="hide"/>
                <field name="periodicity" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_clara_card_kanban" model="ir.ui.view">
        <field name="name">clara.card.kanban</field>
        <field name="model">clara.card</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column" records_draggable="0" group_create="0" group_delete="0" group_edit="0" create="false" edit="false" delete="false" quick_create="false">
                <field name="cardholder_name"/>
                <field name="last_four"/>
                <field name="card_type"/>
                <field name="status"/>
                <field name="area"/>
                <field name="monthly_limit"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong t-esc="record.cardholder_name.value"/>
                                    <span class="text-muted ms-1">·<t t-esc="record.last_four.value"/></span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mt-2">
                                <div><i class="fa fa-credit-card me-2"/><t t-esc="record.card_type.value"/> <span class="text-muted" t-if="record.area.value">· <t t-esc="record.area.value"/></span></div>
                                <div><i class="fa fa-money me-2"/>Límite mensual: <field name="monthly_limit"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_clara_card_form" model="ir.ui.view">
        <field name="name">clara.card.form</field>
        <field name="model">clara.card</field>
        <field name="arch" type="xml">
            <form string="Tarjeta" create="false" edit="false" delete="false">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_transactions" icon="fa-list">
                            <field name="transaction_count" widget="statinfo" string="Transacciones"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Tarjeta">
                            <field name="last_four"/>
                            <field name="card_type"/>
                            <field name="status_raw"/>
                            <field name="monthly_limit"/>
                            <field name="periodicity"/>
                            <field name="currency_id"/>
                            <field name="alias"/>
                        </group>
                        <group string="Titular">
                            <field name="cardholder_name"/>
                            <field name="cardholder_email"/>
                            <field name="cardholder_uuid"/>
                            <field name="area"/>
                            <field name="analytic_rule_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                        <group string="Sincronización">
                            <field name="clara_uuid"/>
                            <field name="last_sync_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_clara_card_search" model="ir.ui.view">
        <field name="name">clara.card.search</field>
        <field name="model">clara.card</field>
        <field name="arch" type="xml">
            <search>
                <field name="cardholder_name"/>
                <field name="last_four"/>
                <field name="area"/>
                <field name="cardholder_email"/>
                <filter name="active_cards" string="Activas" domain="[('status', '=', 'active')]"/>
                <filter name="blocked" string="Bloqueadas" domain="[('status', '=', 'blocked')]"/>
                <filter name="inactive" string="Inactivas" domain="[('status', '=', 'inactive')]"/>
                <filter name="cancelled" string="Canceladas" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter name="physical" string="Físicas" domain="[('card_type', '=', 'physical')]"/>
                <filter name="virtual" string="Virtuales" domain="[('card_type', '=', 'virtual')]"/>
                <group name="group_by">
                    <filter name="group_area" string="Área" context="{'group_by': 'area'}"/>
                    <filter name="group_status" string="Estado" context="{'group_by': 'status'}"/>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'card_type'}"/>
                    <filter name="group_cardholder" string="Titular" context="{'group_by': 'cardholder_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_clara_cards" model="ir.actions.act_window">
        <field name="name">Tarjetas</field>
        <field name="res_model">clara.card</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_clara_card_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin tarjetas de Clara todavía</p>
            <p>La acción planificada las lee de Clara cada domingo a las 10:00 p. m.; un administrador puede pulsar «Sincronizar ahora».</p>
        </field>
    </record>
</odoo>
