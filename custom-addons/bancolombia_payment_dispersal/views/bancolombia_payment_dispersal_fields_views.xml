<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bancolombia_payment_dispersal_field_view_search" model="ir.ui.view">
        <field name="name">bancolombia.payment.dispersal.field.view.search</field>
        <field name="model">bancolombia.payment_dispersal_field</field>
        <field name="arch" type="xml">
            <search string="Search excel fields">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active','=', False)]"/>
                <group>
                    <filter string="Company" name="company_id" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bancolombia_payment_dispersal_field_view_form" model="ir.ui.view">
        <field name="name">bancolombia.payment.dispersal.field.view.form</field>
        <field name="model">bancolombia.payment_dispersal_field</field>
        <field name="arch" type="xml">
            <form string="Excel field">
                <sheet>
                    <div name="button_box" class="oe_button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title" name="bancolombia_payment_dispersal_field_title">
                        <label for="name" id="bancolombia_payment_dispersal_field_title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Type of Document Beneficiary" class="d-block" required='1'/>
                            <field name="active" invisible='1'/>
                        </h1>
                    </div>
                    <group>
                        <field name="value" required='1'/>
                    </group>
                    <group>
                        <group name="info_left">
                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bancolombia_payment_dispersal_field_view_tree" model="ir.ui.view">
        <field name="name">bancolombia.payment.dispersal.field.view.tree</field>
        <field name="model">bancolombia.payment_dispersal_field</field>
        <field name="arch" type="xml">
            <list string="Excel fields">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" invisible='1'/>
            </list>
        </field>
    </record>

    <record id="bancolombia_payment_dispersal_field_action" model="ir.actions.act_window">
        <field name="name">Configuration payment dispersal fields</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bancolombia.payment_dispersal_field</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your excel field to payment dispersal Bancolombia
            </p>
        </field>
    </record>

</odoo>
