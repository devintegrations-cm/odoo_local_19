<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bancolombia_payment_dispersal_inherit_view_account_payment_dispersion_form" model="ir.ui.view">
        <field name="name">bancolombia.payment.dispersal.inherit.view.account.payment.dispersion.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="bancolombia_payment_type"
                       invisible="payment_method_code != 'bancolombia_dispersion'"/>
                <field name="bancolombia_type_of_transaction"
                       invisible="payment_method_code != 'bancolombia_dispersion'"/>
            </xpath>
        </field>
    </record>

    <record id="bancolombia_payment_dispersal_inherit_view_account_payment_tree" model="ir.ui.view">
        <field name="name">bancolombia.payment.dispersal.inherit.view.account.payment.list</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="payment_method_line_id" position="after">
                <field name="bancolombia_payment_type" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
